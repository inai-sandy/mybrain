generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// The single owner of this brain.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// Simple key/value app settings (e.g. the chosen LLM provider+model).
model Setting {
  key   String @id
  value String
}

/// A service connector whose secrets are stored encrypted at rest.
model Connector {
  id        String   @id @default(uuid())
  name      String   @unique // supermemory | rag | notion | telegram | raindrop | anthropic
  secrets   String // AES-256-GCM encrypted JSON
  updatedAt DateTime @updatedAt
}

/// A stored piece of content (research md, bookmark, etc.). Source of truth is the file on disk.
model Item {
  id            String   @id @default(uuid())
  contentHash   String
  source        String // upload | url | notion | raindrop
  title         String?
  summary       String? // short AI/heuristic summary
  sourceUrl     String? // original link for url / notion sources
  filePath      String?
  tags          String? // JSON array of strings
  supermemoryId String?
  ragId         String?
  readFailed    Boolean  @default(false) // bookmark whose page could not be read (summary from metadata only)
  readAttempts  Int      @default(0) // failed read tries so far — retries stop at the cap, so dead links stop costing money (BEA-841)
  shared        Boolean  @default(false) // publicly viewable via /view/:id when true
  thumbnail     String? // cover image / YouTube thumbnail for bookmark cards
  ideaId        String? // links an uploaded research doc to an Idea
  folderId      String? // bookmark folder (My-Brain-owned, independent of Raindrop) (BEA-611)
  lastOpenedAt  DateTime? // when the owner last opened it — Rediscover surfaces what he has NOT seen (BEA-1048)
  createdAt     DateTime @default(now())

  @@unique([contentHash, source])
  @@index([folderId])
}

/// A My-Brain-owned folder for organising bookmarks (independent of Raindrop). (BEA-611)
/// A life event mined from the owner's own story ("morning at the factory") — shown on the
/// Activity timeline next to app events, so the timeline shows his day, not just his clicks. (BEA-1051)
model DayEvent {
  id        String   @id @default(uuid())
  day       String // YYYY-MM-DD
  at        String? // rough time: "morning" | "afternoon" | "evening" | "HH:MM"
  title     String
  detail    String?
  source    String   @default("story")
  createdAt DateTime @default(now())

  @@index([day])
}

model BookmarkFolder {
  id        String   @id @default(uuid())
  name      String
  color     String?
  icon      String? // lucide icon name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A captured idea: a brain-dump cleaned up by the LLM, with a /deep-research prompt.
model Idea {
  id             String    @id @default(uuid())
  rawDump        String
  title          String
  content        String
  researchPrompt String
  status         String    @default("open") // open | done
  supermemoryId  String?
  ragId          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

/// A saved agentic workflow for an idea (n8n-style): an ordered list of nodes (skills + text steps).
model IdeaWorkflow {
  id           String   @id @default(uuid())
  ideaId       String?  @unique // the idea this flow belongs to (null = a reusable template)
  name         String   @default("Workflow")
  isTemplate   Boolean  @default(false)
  nodes        String   @default("[]") // JSON: [{id,type:'skill'|'text',skill?,text?,config?}]
  customPrompt String? // user-edited Claude Code prompt; null = use the auto-generated one
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A Claude skill the user tracks (created on Claude Code/Chat, or downloaded).
model Skill {
  id            String    @id @default(uuid())
  title         String
  description   String
  content       String? // the SKILL.md content (pasted/uploaded) — served as the download
  origin        String    @default("created") // created | downloaded
  platform      String    @default("code") // code | chat
  downloadUrl   String? // external link when not app-hosted
  filePath      String? // app-hosted uploaded file (Skills ②)
  slug          String? // skill folder name (auto-scan match)
  source        String? // where it was found (auto-scan)
  deployments   String?   @default("{}") // JSON {targetName: folderSlug} — per-target install tracking (BEA-634)
  inUse         Boolean? // manual using/not-using flag
  installed     Boolean   @default(false) // detected on the server (auto-scan)
  lastUsedAt    DateTime? // from transcripts (auto-scan)
  usageCount    Int       @default(0)
  shared        Boolean   @default(false)
  // Source tracking (BEA-977) — the "lock model" that powers update-without-duplicate, mirroring `npx skills`.
  sourceRepo    String? // "owner/repo" this skill was imported from
  sourceRef     String? // branch/tag/ref it was pulled at
  skillPath     String? // path of the skill folder within the repo (its identity for updates)
  sourceUrl     String? // the exact GitHub URL pasted
  folderHash    String? // content hash of the installed folder — "changed since import?" check
  packId        String? // grouping id (slug of owner/repo) — a multi-skill repo is one Pack in the UI
  packName      String? // human name for the pack (the repo name)
  bundlePaths   String? // JSON array of sub-skill paths when this row is a "bundle" (one skill, styles inside) (BEA-979)
  sourceUpdatedAt DateTime? // last time we refreshed this skill from its source
  supermemoryId String?
  ragId         String?
  createdAt     DateTime  @default(now())

  /// One row per imported source. Backs the "never duplicate" promise at the DB level — import's
  /// findBySource→create is check-then-act and runs detached, so two concurrent imports of the same
  /// repo could both create. NULLs are distinct in SQLite, so hand-created and bundle rows
  /// (skillPath = NULL) are unaffected. (BEA-984)
  @@unique([sourceRepo, skillPath])
}

/// A morning brain-dump: the raw multi-sentence text the LLM turns into tasks.
model BrainDump {
  id        String   @id @default(uuid())
  day       String // local day key YYYY-MM-DD this dump belongs to
  rawText   String
  source    String   @default("app") // app | telegram | voice
  question  String? // a single clarifying question the LLM asked, if any
  taskCount Int      @default(0)
  createdAt DateTime @default(now())
}

/// The mandatory nightly story — the user's free narrative of the day (problems, joy, events).
model Story {
  id              String   @id @default(uuid())
  day             String // local day key YYYY-MM-DD
  rawText         String
  source          String   @default("app") // app | telegram | voice
  mood            String? // optional one-tap mood/energy
  workedMinutes   Int? // user-stated hours worked that day (the real working-hours figure)
  workedBreakdown String? // JSON [{category, minutes}] — AI split of the stated hours across topics
  emotions        String? // JSON {lifted[], drained[], energy, worry, feeling} mined from his own words (BEA-1051)
  supermemoryId   String? // Explore index doc ids (so re-index replaces, no dupes)
  ragId           String?
  // The deep read of this story, kept so step 2 of the Close-day wizard never pays for the same
  // call twice. minedHash fingerprints the text it was read from, so an edit is visible. (BEA-1164)
  mined           String? // JSON MinedPayload
  minedHash       String?
  minedAt         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// The AI's end-of-day summary of everything the user did — stored to Activity + RAG/SuperMemory.
model DaySummary {
  id            String   @id @default(uuid())
  day           String   @unique // local day key YYYY-MM-DD
  text          String
  stats         String? // JSON: { tasksDone, tasksOpen, minutesSpent, ... }
  supermemoryId String?
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The nightly "Story of the Day" — story + tasks + activity woven into one emotional narrative (11:58 PM).
model DayStory {
  id                String   @id @default(uuid())
  day               String   @unique // local day key YYYY-MM-DD
  text              String // the woven story
  mood              String? // one-word mood read from the day
  moodScore         Int? // 0-100 wellbeing read from the day
  personalText      String? // the personal-life narrative (text = professional when this is set)
  proMoodScore      Int? // 0-100 work mood
  personalMoodScore Int? // 0-100 personal/home mood
  model             String? // which LLM produced it
  supermemoryId     String? // Explore index doc ids (re-index replaces, no dupes)
  ragId             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

/// A predicted task for an upcoming day, proposed by the Story of the Day — the user approves it with "+".
model SuggestedTask {
  id        String   @id @default(uuid())
  forDay    String // local day key YYYY-MM-DD this is suggested FOR (usually tomorrow)
  title     String
  category  String?
  reason    String? // why the Story of the Day suggests it
  status    String   @default("pending") // pending | added | dismissed
  createdAt DateTime @default(now())

  @@index([forDay]) // matches the migration-created index (BEA-828)
}

/// One evidence-grounded read of the user's personality — confirmable in the Validate panel.
model PersonalityInsight {
  id         String   @id @default(uuid())
  generation Int      @default(1) // bumped each regeneration
  dimension  String // e.g. "Follow-through", "Peak hours", "Procrastination"
  claim      String // the honest observation
  evidence   String? // the concrete data it's grounded in
  status     String   @default("pending") // pending | confirmed | rejected
  createdAt  DateTime @default(now())
}

/// One AI request's cost record (feature label + model + tokens + exact OpenRouter cost).
model UsageLog {
  id               String   @id @default(uuid())
  at               DateTime @default(now())
  feature          String // chat | chat-router | task-dump | story-of-day | mentor-guidance | voice-cleanup | …
  model            String
  promptTokens     Int?
  completionTokens Int?
  cost             Float? // USD — exact from OpenRouter; null where the provider doesn't report it

  @@index([at]) // matches the migration-created indexes (BEA-828)
  @@index([feature])
}

/// A quick-capture note (Google Keep style) — LOCAL ONLY, never synced to RAG/SuperMemory.
model Note {
  id            String   @id @default(uuid())
  title         String?
  content       String? // plain-text body
  checklist     String? // JSON array of { text, done } for checklist notes
  color         String   @default("default") // color key, shown as a top strip
  tags          String? // JSON array of strings
  pinned        Boolean  @default(false)
  archived      Boolean  @default(false)
  supermemoryId String? // Explore index doc ids (only set when Notes indexing is enabled)
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([archived, pinned]) // matches the migration-created index (BEA-828)
}

/// Per-section index control for Explore: whether a source is indexed + when it last was. (BEA-335)
model IndexSource {
  type          String    @id // task | story | item | idea | meeting | note
  enabled       Boolean   @default(true)
  lastIndexedAt DateTime?
  updatedAt     DateTime  @updatedAt
}

/// A saved Explore answer (question + synthesised answer + its sources). Separate from the index. (BEA-339)
model ExploreSave {
  id        String   @id @default(uuid())
  question  String
  answer    String
  sources   String? // JSON array of the source cards shown with the answer
  createdAt DateTime @default(now())
}

/// A focus area / direction the Mentor tracks — derived from stories or set by the user, then confirmed.
model FocusArea {
  id          String   @id @default(uuid())
  title       String
  description String?
  source      String   @default("derived") // derived | user
  status      String   @default("proposed") // proposed | active | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// One day's Mentor read — how well the day followed the focus areas + the guidance written for it.
model MentorDay {
  id             String   @id @default(uuid())
  day            String   @unique // local day key YYYY-MM-DD
  adherenceScore Int // 0-100: how well the day aligned with the active focus areas
  moodScore      Int? // 0-100 wellbeing carried from the Story of the Day
  guidance       String // the Mentor's direct guidance for the day
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A document in the Documents library — md/html files the user creates to share & re-use.
/// Separate from Item/Capture: NOT indexed into memory unless the user explicitly converts it. (BEA-532)
model Document {
  id            String    @id @default(uuid())
  slug          String    @unique // stable public/url key (editable link name)
  shortCode     String?   @unique // short share code -> /s/:code (BEA-584)
  sharePassword String? // bcrypt hash; when set, the public link asks for a password (BEA-585)
  expiresAt     DateTime? // when set + passed, the public link is treated as un-shared (BEA-585)
  viewCount     Int       @default(0) // public opens of the shared link (BEA-586)
  starred       Boolean   @default(false) // favourited by the owner (BEA-596)
  allowDownload Boolean   @default(false) // let recipients of a shared link download it (BEA-597)
  siteEntry     String? // for kind 'site': entry html path inside the extracted folder (BEA-587)
  title         String
  description   String? // <=200 char summary (manual now; AI-filled later)
  kind          String    @default("md") // md | html | pdf | image | doc | site | other
  mime          String?
  filename      String?
  contentText   String? // md/html text content (binary files use filePath later)
  filePath      String? // for pdf/images on the volume (later step)
  bytes         Int?
  sourceUrl     String? // when imported from the internet (later step)
  originServer  String? // when landed from another server (later step)
  collectionId  String? // folder/collection (later step)
  tags          String    @default("[]") // JSON string array
  noIndex       Boolean   @default(false) // agent/flow outputs stay OUT of the brain until "Add to my Brain" (BEA-1101)
  shared        Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([kind])
  @@index([collectionId])
}

/// A folder/collection for grouping documents. (BEA-537)
model DocumentCollection {
  id        String   @id @default(uuid())
  name      String
  color     String?
  icon      String? // lucide icon name for the folder tile (BEA-588)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The Mentor's Sunday weekly review: the week's wins, drift, one pattern, one experiment.
model WeeklyReview {
  id         String   @id @default(uuid())
  weekStart  String   @unique // Monday of the reviewed week, local YYYY-MM-DD
  text       String // the review prose
  pattern    String? // the ONE pattern the mentor noticed this week
  experiment String? // the ONE experiment proposed for next week
  stats      String? // JSON numbers the review was grounded in
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// A month of life woven into one chapter (from the Stories of the Day) — and the building block of the year book.
model MonthStory {
  id            String   @id @default(uuid())
  month         String   @unique // YYYY-MM
  title         String? // chapter title
  text          String
  supermemoryId String? // Explore index doc ids (re-index replaces, no dupes)
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// The Story of the Year — the book itself, woven from the monthly chapters (Dec 31 + on-demand "year so far").
model YearStory {
  id            String   @id @default(uuid())
  year          String   @unique // YYYY
  title         String?
  text          String
  partial       Boolean  @default(false) // true = a "year so far" draft, rewritten as months land
  supermemoryId String? // Explore index doc ids (re-index replaces, no dupes)
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// One person mentioned in the user's own story on one day (people memory; aggregated per person in code).
model PersonMention {
  id        String   @id @default(uuid())
  name      String // canonical display name
  day       String // local day key
  createdAt DateTime @default(now())

  @@unique([name, day])
}

/// A sealed day — once a DayClose row exists for a day, that day is finalized (story/mood/mentor are final, leftovers have rolled forward). Absence = the day is still open.
model DayClose {
  id       String   @id @default(uuid())
  day      String   @unique // local day key YYYY-MM-DD
  auto     Boolean  @default(false) // true = auto-sealed after the grace window, false = user closed it
  closedAt DateTime @default(now())
}

/// A quick note the user speaks/types during the day (daytime oral capture).
model DayNote {
  id        String   @id @default(uuid())
  day       String // local day key YYYY-MM-DD
  text      String
  source    String   @default("app") // app | telegram | voice
  createdAt DateTime @default(now())
}

/// A task in the daily loop.
model Task {
  id            String    @id @default(uuid())
  title         String
  note          String?
  category      String? // AI-learned bucket (Beakn, Learning, Admin, Health…)
  tags          String? // JSON array of strings
  priority      String    @default("medium") // high | medium | low
  sphere        String    @default("work") // work | personal — which life this task belongs to
  pinned        Boolean   @default(false) // a top 1–3 must-do for the day
  estimateMin   Int? // AI time estimate in minutes
  actualMin     Int? // user-reported actual time on completion
  reminderCount Int       @default(0) // how many reminders the user wants
  reminders     String? // JSON array of ISO datetimes (AI-scheduled)
  day           String? // local day key YYYY-MM-DD this task is planned for
  dumpId        String? // the BrainDump this task was extracted from
  party         String? // display text for the person — kept in sync with ownerContact when linked (BEA-604)
  /// The person this task really belongs to. null = it's mine. A real link, so renaming a contact
  /// carries every task with it and nothing is lost to a typo or a nickname. (BEA-1019)
  ownerContactId String?
  ownerContact   Contact? @relation("TaskOwner", fields: [ownerContactId], references: [id], onDelete: SetNull)
  /// Everyone else this task touches — the @mentions. (BEA-1019)
  people        TaskPerson[]
  /// The chases running on this task. (BEA-1021)
  chases        Reminder[]
  /// Every time this work changed hands. (BEA-1308)
  handovers     TaskHandover[]
  /// Times someone said this was finished. A claim is NOT done — the owner confirms. (BEA-1024)
  claims        TaskClaim[]
  /// For a recurring task: one row per day, did today's status arrive? (BEA-1117)
  /// For a recurring task: which weekdays it is owed on, as JSON ["Mon","Wed"]. Null = every
  /// working day (the old behaviour). A Friday report must not be chased on a Monday. (BEA-1147)
  scheduleDays  String?
  statusDays    TaskStatusDay[]
  teamUpdates   TeamUpdate[]
  /// The date they promised. Slows the chase to once a day until then — never pauses it, because
  /// silence must always still reach the owner. (BEA-1022)
  promisedFor   String? // local day key YYYY-MM-DD
  promisedAt    DateTime? // when they said it
  promiseSlips  Int       @default(0) // how many times they've re-promised — feeds the neglect digest
  /// The briefing that produced this task, if it came from one. (BEA-1020)
  briefingId    String?
  briefing      Briefing? @relation(fields: [briefingId], references: [id], onDelete: SetNull)
  reminderSuggestDismissed Boolean @default(false) // user cleared this from "Suggested reminders" (BEA-882)
  brainEater    Boolean   @default(false) // circles his head, keeps getting skipped — lives in its own tab (BEA-1056)
  dueDate       DateTime?
  /// open | done | dropped. (BEA-1306)
  /// `dropped` = it ended WITHOUT being finished — the person left, it was called off, it stopped
  /// mattering. It must never be counted as finished work, and it is not deleted: what was dropped,
  /// and why, is worth keeping. Ask for open work by name (`OPEN_WORK` in tasks/task-status.ts),
  /// never as "not done" — that phrasing silently counts dropped work as still owed.
  status        String    @default("open")
  /// Does this work ever FINISH? (BEA-1117)
  ///   assignment — a one-off deliverable: they claim it, the owner confirms, the chase ends.
  ///   recurring  — a standing daily report (production update, OT update). It NEVER completes;
  ///                a status arriving satisfies TODAY only and the chase returns tomorrow.
  /// `Reminder.repeat` says how often we chase; this says whether the work can be finished at all.
  /// Confirming a recurring task done would kill the chase forever — so claims are blocked on it.
  kind          String    @default("assignment") // assignment | recurring
  progress      Int       @default(0) // 0 | 30 | 60 | 100 — how far along (100 = done)
  followUp      Boolean   @default(false) // true if this task was spawned as a follow-up to another
  rolloverCount Int       @default(0)
  supermemoryId String? // Explore index doc ids (so re-index replaces, no dupes)
  ragId         String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  /// When it was dropped, and why. Separate from `completedAt` on purpose: that one means FINISHED,
  /// and every report that counts finished work reads it. (BEA-1306)
  droppedAt     DateTime?
  droppedReason String?

  @@index([ownerContactId])
  @@index([briefingId])
}

/// One handover of a piece of work from one person to another. (BEA-1308)
///
/// A job used to belong to whoever it started with, for ever — which is why, when Radha left, her
/// open work had nowhere to go and the only options were to pretend it was finished or delete it.
///
/// Kept as its own row rather than a "previous owner" column so the whole chain survives: work that
/// passes through three people remembers all three. It is also the first piece of real history on a
/// task, which the app has never had.
model TaskHandover {
  id            String   @id @default(uuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  /// Null when the work was the owner's own before it was given to somebody.
  fromContactId String?
  toContactId   String
  reason        String?
  at            DateTime @default(now())

  @@index([taskId])
}

/// Did a recurring task's status arrive on a given day? One row per task per local day (IST).
/// A recurring report is never "done" — it is satisfied for TODAY and owed again tomorrow, so the
/// unit of truth is the day, not the task. Also what the end-of-day miss summary reads. (BEA-1117)
model TaskStatusDay {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  day       String // local day key YYYY-MM-DD, in the owner's timezone
  status    String   @default("received") // received | missed
  /// Their own words that satisfied the day — evidence, never rewritten.
  quote     String?
  /// A 1–2 line AI summary of the quote (figures kept), written once when the report arrives —
  /// what the owner reads; the quote stays one tap deeper. (BEA-1223)
  summary   String?
  contactId String?
  /// Where the signal came from — "page" (their share link) or "whatsapp" (a real reply). (BEA-1152)
  source    String?
  /// When that signal happened. A LATER signal always overrides an earlier one, so a tick followed
  /// by "sending at 12" ends up not-received rather than received. (BEA-1152)
  signalAt  DateTime?
  createdAt DateTime @default(now())

  @@unique([taskId, day])
  @@index([day])
  @@index([taskId])
}

/// The situation you told me about a person, in your own words — and the work it produced.
/// Standing context: the agent reads a contact's briefings before it replies to them, so a
/// conversation never starts cold. Many per contact, newest first. (BEA-1020)
model Briefing {
  id        String   @id @default(uuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  rawText   String // exactly what the owner said or typed — never rewritten
  summary   String? // a short AI one-liner, for the list
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  /// Brain doc ids, so a re-index REPLACES rather than piling up duplicates. (BEA-1031)
  supermemoryId String?
  ragId         String?

  @@index([contactId])
}

/// Someone said a task is finished. That is a CLAIM, never a completion: the work is only done
/// when the owner confirms it. Keeps their exact words as the evidence he decides on. (BEA-1024)
model TaskClaim {
  id        String    @id @default(uuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contactId String? // who said it (null if the owner's own voice closed it)
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  source    String    @default("whatsapp") // whatsapp | page | owner
  quote     String // their exact words — what the owner reads before deciding
  /// pending | confirmed | rejected | moot
  /// `moot` = the work was DROPPED before the owner ruled on the claim (BEA-1306). Not confirmed,
  /// which would say "yes, you finished it" about work just recorded as not done; not rejected,
  /// which would say "no, you didn't" when nobody decided that either. The question simply stopped
  /// needing an answer, and it leaves the review list without a verdict being invented.
  status    String    @default("pending")
  reason    String? // why the owner rejected it
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status])
  @@index([taskId])
  @@index([contactId])
}

/// One person linked to one task by an @mention — the cross-contact link, visible from both sides.
/// The task's OWNER is Task.ownerContactId; this is everyone else it touches. (BEA-1019)
model TaskPerson {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, contactId])
  @@index([contactId])
}

/// Outbox: every memory write is queued here, then a worker drains it to both stores with retries.
model MemoryOutbox {
  id        String   @id @default(uuid())
  itemId    String? // the ref row's id (named itemId for back-compat); refType says which table
  refType   String? // item (default/null) | task | story | idea | meeting — which table to write the doc id back to
  target    String // supermemory | rag
  op        String   @default("upsert")
  payload   String // JSON
  status    String   @default("pending") // pending | done | failed
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Generic polling/sync cursor (e.g. id="raindrop").
model SyncState {
  id        String   @id
  cursor    String?
  updatedAt DateTime @updatedAt
}

/// A chat conversation with the assistant ("talk to my brain"), scoped to one memory tag.
model ChatSession {
  id            String    @id @default(uuid())
  title         String?
  scope         String    @default("everything") // everything | bookmark | idea | activity | document | skill
  docId         String? // set = a per-document chat bound to this Item (answers only from that doc)
  summary       String? // rolling summary of older turns (keeps long threads cheap)
  pinned        Boolean   @default(false) // protected from retention auto-clean
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
}

/// One message in a chat thread.
model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  role      String // user | assistant
  content   String
  sources   String? // JSON array of {title, url?, itemId?}
  followups String? // JSON array of suggested next questions
  /// Outside services this reply actually used (BEA-1349) — JSON array of chips: service, action, ok, result, link.
  tools     String?
  /// An action that cannot be undone, waiting for the owner's tap (BEA-1349) — JSON of the pending gate + his answer.
  gate      String?
  starred   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([sessionId])
}

/// A starred message — a preserved copy that is NEVER auto-deleted by retention.
model ChatStar {
  id           String   @id @default(uuid())
  messageId    String   @unique
  sessionId    String?
  sessionTitle String?
  scope        String   @default("everything")
  role         String
  content      String
  sources      String?
  createdAt    DateTime @default(now())
}

/// Audit log of every action the agent takes.
model AgentActionLog {
  id        String   @id @default(uuid())
  sessionId String?
  tool      String
  args      String? // JSON
  result    String?
  createdAt DateTime @default(now())
}

/// A configured agent the user can run (flagship Agent feature). Runs on Hermes; My Brain is the shell.
/// An agent AREA (BEA-1095): the container the owner thinks of as "an agent" — Research Agent,
/// Daily News… It holds a Tools list and many jobs (Agent rows). Jobs stay in the Agent table so
/// every run/flow/waitpoint reference keeps working.
/// A flat folder on the Agents home (BEA-1380). The owner creates these and moves his agent cards
/// (AgentArea rows) into them; "All" and "Unfiled" are views, not rows. Deleting a folder un-files
/// its agents — it never deletes them.
model AgentFolder {
  id        String   @id @default(uuid())
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model AgentArea {
  id          String   @id @default(uuid())
  name        String
  folderId    String? // the flat folder this agent card sits in (BEA-1380); null = Unfiled
  icon        String? // emoji
  color       String? // card colour
  description String?
  tools       String   @default("[]") // JSON [{kind: skill|api|mcp|cli, name, note?, status: installed|needed}] — the visible toolbox
  outcome     String? // the agent's STANDING definition of done — what any run of it must achieve (BEA-1173); jobs without their own Outcome are graded against this
  sourceUrl   String? // GitHub origin when imported
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agent {
  id           String     @id @default(uuid())
  areaId       String? // the AgentArea this job belongs to (BEA-1095); null only transiently pre-migration
  name         String
  icon         String? // emoji
  description  String?
  prompt       String? // the task template the agent runs (the scheduled/run-now instruction)
  rubric       String? // the Outcome — the definition of done each run is graded against (BEA-641)
  evals        String     @default("[]") // JSON [{id,input,lastVerdict,lastScore,lastRunId,lastRunAt}] — regression cases (BEA-642)
  autonomy     String     @default("cautious") // cautious | balanced | autopilot
  skills       String     @default("[]") // JSON string array of skill ids/names
  tools        String     @default("[]") // JSON string array of catalog tool ids this job may use (BEA-1168); empty = inherit the agent's toolbox
  origin       String     @default("chat") // chat | voice | import — how this job was created (BEA-1175/1176)
  schedule     String? // JSON { every: day|weekday|week|hour, at?: "HH:MM", dow?: 0-6 }; null = manual only
  scheduleText String? // human sentence ("every weekday 7am")
  lastFiredKey String? // "<dayKey>:<HH:MM>" of the last scheduled fire — dedup so a schedule fires once
  outputDest   String     @default("document") // document | telegram | task | sheet — sheet = a Google Sheet through the seam (BEA-1357)
  sheetId      String? // outputDest 'sheet': append every run to THIS spreadsheet; null = a new sheet per run (BEA-1357)
  sheetAppend  Boolean    @default(false) // outputDest 'sheet' + no sheetId yet: "keep adding" — the first run creates ONE sheet and stores its id here as sheetId; every later run appends, de-duped on the sheet's key column (BEA-1374)
  toolArgs     String? // JSON { "<source id>": { actionId, args, _pages? } | creators block } — the sources a direct-fetch job (Social) runs, keyed by SOURCE id so several may share one action (BEA-1374; the older { "<svc id>": args } shape is read transparently); no engine turn (BEA-1357)
  // Watch / Alert (BEA-1358): how a direct-fetch job treats its result. run = fetch every time |
  // watch = diff against last time, output ONLY what changed | alert = watch + a condition → push.
  mode           String  @default("run")
  alertCondition String? // plain-English condition an Alert judges over the diff ("a new post mentions a price")
  threshold      String? // JSON { field?: string, dir: "above"|"below", value: number } — a number to cross, judged without a model
  pausedReason   String? // why the job switched itself off (the daily credit ceiling) — cleared when it is switched back on
  defaultDepth String     @default("standard") // quick | standard | deep — default run depth (BEA-695)
  collectionId String? // Documents collection for saved outputs
  category     String? // shelf group on the Agents home (Daily | Research | People | Brain care | Imported | Other) — null = auto-guessed (BEA-1087)
  sourceUrl    String? // where an imported agent came from (the GitHub link) — the origin badge (BEA-1081/1083)
  ui           String? // JSON mini-interface spec {inputs:[{key,label,type,options?,placeholder?}], view, headline} (BEA-1082)
  color        String? // card/stripe colour (hex or named, the Claude-agent `color:` convention) — null = palette by category (BEA-1087)
  // Per-job settings (BEA-1095): each job is fully independent.
  notifyWhatsApp Boolean  @default(false) // send this job's finished output to WhatsApp (BEA-1102)
  keepDays     Int? // dated-history retention in days; null = keep forever (BEA-1099)
  engine       String? // JSON {provider, model} — this job's own model, overrides the global agent model (BEA-1106)
  chatLog      String     @default("[]") // JSON [{who: you|ai, text, at}] — the persisted change-by-chatting history (BEA-1097)
  indexToBrain Boolean    @default(false) // outputs are NEVER auto-indexed; the "Add to my Brain" tap flips per output (BEA-1101)
  enabled      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  runs         AgentRun[]
}

/// What a Watch/Alert job saw last time (BEA-1358) — one row per (job, action, arguments), so the next
/// run can say ONLY what changed. `lastResult` is the provider's cleaned answer, capped; `lastHash` is
/// its stable hash (envelope keys and volatile CDN links left out). A failed fetch never touches the row.
model SocialWatch {
  id            String    @id @default(uuid())
  agentId       String
  actionId      String
  args          String    @default("{}") // JSON — the exact arguments this baseline belongs to
  argsHash      String // stable hash of `args` (the unique key; SQLite cannot key on JSON)
  lastHash      String
  lastResult    String // JSON, capped
  lastAt        DateTime  @default(now())
  /// Once-only alerts: "met" | "unmet" for a numeric threshold, so a number that STAYS above pushes once.
  alertState    String?
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([agentId, actionId, argsHash])
  @@index([agentId])
}

/// ONE run at a time per job (BEA-1388, `specs/AGENT-WORKERS.md` §G). Before anything starts a job —
/// the scheduler, a manual tap, an event trigger, the worker road, later the repair loop — it claims
/// this row. `jobId` is UNIQUE, and that uniqueness IS the claim: an INSERT either wins or is rejected,
/// so two starts of one job can never both begin. Released on a terminal state (done/failed/cancelled)
/// and, if the holder dies without releasing, taken over once `expiresAt` has passed. No FK on purpose
/// (like SocialWatch) — `deleteAgent` drops the row by hand.
model JobRunLock {
  id        String   @id @default(uuid())
  /// The agent this lock belongs to. Unique — one lock row per job, ever.
  jobId     String   @unique
  /// A token minted by whoever claimed it, never reused. Only the holder may release.
  holder    String
  /// The run being protected, when there is one (a repair turn claims before it has a run).
  runId     String?
  /// Plain words for the log and the skipped-fire step: "scheduled run", "manual run", "repair".
  reason    String?
  takenAt   DateTime @default(now())
  /// The only safety net until the stall watchdog exists (piece 7): past this the lock may be taken
  /// over, so a crashed holder cannot wedge a job for ever.
  expiresAt DateTime

  @@index([expiresAt])
}

/// One execution of an agent. Mirrors a Hermes session and carries our durable HITL state.
model AgentRun {
  id          String      @id @default(uuid())
  agentId     String?
  agent       Agent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)
  depth       String? // quick | standard | deep — the depth this run used (BEA-695)
  title       String?
  status      String      @default("running") // running | awaiting_input | scheduled | done | failed | cancelled
  input       String? // the prompt/topic (JSON or text)
  sessionId   String? // Hermes session id (the bridge fills this in BEA-618)
  /// Which road this run is on (BEA-1387): engine (a Codex turn) | worker | plan. The Codex resume
  /// sweeper only resumes `engine` runs — a parked worker must never wake up as a live Codex turn.
  runKind     String      @default("engine")
  stepLog     String      @default("[]") // JSON array of step records (mirror of Hermes events)
  learnings   String      @default("[]") // JSON [{text,status:proposed|kept|forgotten,memId?}] — what the run learned (BEA-624)
  outputDocId String? // saved Document id
  outputUrl   String? // an outside link the run produced — the Google Sheet it wrote (BEA-1357)
  resultText  String? // the agent's final answer text, shown inline on the run (BEA-630)
  grade       String? // JSON grade vs the agent's Outcome rubric {verdict,score,criteria,notes} (BEA-641)
  error       String?
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  waitpoints  Waitpoint[]

  @@index([agentId])
  @@index([status])
}

/// A DURABLE human-in-the-loop pause: the run asks a question and waits — survives an API/host restart. The piece Hermes lacks.
model Waitpoint {
  id           String    @id @default(uuid())
  runId        String
  run          AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  question     String
  kind         String    @default("choice") // choice | free_text | approve_edit_reject | form
  options      String    @default("[]") // JSON: choices, or form fields, or the draft for approve_edit_reject
  defaultValue String? // smart default applied on timeout
  status       String    @default("pending") // pending | answered | expired | cancelled
  answer       String? // JSON of the user's answer
  resumeToken  String    @unique
  answeredVia  String? // telegram | web
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  answeredAt   DateTime?

  @@index([runId])
  @@index([status])
}

/// One day's Gmail "Daily Brief": unread count + an AI summary of that day's important emails.
/// Generated nightly (11:58 PM local) and on first open; keyed by local day so history is instant.
model GmailBrief {
  day           String   @id // YYYY-MM-DD in the user's timezone
  unread        Int      @default(0)
  summary       String   @default("")
  sections      String? // JSON array of {heading, points[], link} accordion topic cards
  items         String? // JSON array of {from, subject, time} important emails
  model         String?
  supermemoryId String? // Explore index doc ids (mandatory section)
  ragId         String?
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A saved "Gmail request": a natural-language email search turned into an AI briefing of one thread.
/// Frozen snapshot (Refresh re-runs it). Optionally shared via a public link, saved to memory, etc.
model GmailRequest {
  id            String   @id @default(uuid())
  query         String // the natural-language ask
  title         String // auto-titled from the query; user-renamable
  threadId      String? // the chosen Gmail thread
  threadSubject String?
  summary       String   @default("") // AI description + key points (markdown)
  emailCopy     String? // the relevant email copy used to build the summary
  shared        Boolean  @default(false)
  shareId       String?  @unique // public token for the share link
  itemId        String? // set if imported to Capture
  supermemoryId String? // Explore index doc ids (mandatory section)
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A recorded meeting. Audio is captured first; transcription + AI summary are opt-in (ticket B).
model Meeting {
  id            String   @id @default(uuid())
  title         String   @default("Untitled meeting")
  agenda        String? // optional pre-meeting notes the AI considers
  audioPath     String? // stored recording on the data volume
  audioMime     String? // e.g. audio/webm
  durationSec   Int      @default(0)
  status        String   @default("recorded") // recorded | transcribing | transcribed
  engine        String? // which transcription engine was used
  transcript    String?
  summary       String?
  takeaways     String? // JSON array of strings
  decisions     String? // JSON array of strings
  actionItems   String? // JSON array of {title, ...}
  language      String?
  tags          String? // JSON array of AI keywords
  savedToMemory Boolean  @default(false)
  supermemoryId String?
  ragId         String?
  shared        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// A commitment the owner made ("I'll send X by Friday") — extracted from the day. (BEA-355)
model Commitment {
  id          String    @id @default(uuid())
  text        String
  party       String? // who it's to / with
  dueDate     String? // YYYY-MM-DD if stated
  status      String    @default("open") // open | done | dropped
  source      String    @default("story") // story | task | meeting | summary
  sourceDay   String // the day it was extracted from
  confirmed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

/// A decision that was made ("we're going with the rust design") — extracted from the day. (BEA-355)
model Decision {
  id        String   @id @default(uuid())
  text      String
  context   String?
  source    String   @default("story")
  sourceDay String
  createdAt DateTime @default(now())
}

/// A proactive connection the brain surfaced on its own (cross-type related items). (BEA-357)
model Connection {
  id        String   @id @default(uuid())
  summary   String
  items     String // JSON [{type, id, title, link}]
  score     Float    @default(0)
  status    String   @default("new") // new | seen | dismissed
  anchorKey String // type:id of the anchor, for dedup
  createdAt DateTime @default(now())
}

/// Vault metadata — the zero-knowledge crypto envelope. Server stores ONLY ciphertext
/// + wrapped keys; never the passphrase, never a raw key, never a plaintext secret. (BEA-345)
model VaultMeta {
  id           String   @id @default(uuid())
  kdfParams    String // JSON: Argon2id memory/iterations/parallelism/hashLength
  salt         String // base64
  verifier     String // JSON {iv,ct}: a known constant encrypted by the vault key
  wrapPass     String // JSON {iv,ct}: vault key wrapped by the passphrase-derived master key
  wrapRecovery String // JSON {iv,ct}: vault key wrapped by the recovery key
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One encrypted vault item. `blob` is the envelope-encrypted secret (ciphertext only).
/// The other columns are SEARCHABLE METADATA only — never a secret value. (BEA-345)
model VaultItem {
  id            String   @id @default(uuid())
  type          String // login | apisecret | card | bank | crypto | identity | document | note | license | wifi | membership
  blob          String // JSON EncryptedBlob {v, item:{iv,ct}, dataKey:{iv,ct}}
  title         String? // searchable
  website       String? // searchable
  username      String? // searchable
  tags          String? // searchable (comma-separated)
  cardType      String? // searchable (e.g. "Visa")
  bankName      String? // searchable
  collection    String? // Personal | Work | Beakn | Family
  favorite      Boolean  @default(false)
  // Pointers to the LABEL-ONLY index docs (BEA-368). Store-doc ids only — never a secret. Lets an
  // edit replace its indexed metadata and a delete remove it. The encrypted `blob` is NEVER indexed.
  supermemoryId String?
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type]) // matches the migration-created indexes (BEA-828)
  @@index([collection])
}

/// A device whose biometric/passkey (WebAuthn PRF) can unlock the vault. Stores ONLY the vault key
/// wrapped by the device's PRF-derived secret — never the key itself, never a biometric. (BEA-352)
model VaultDevice {
  id           String   @id @default(uuid())
  credentialId String   @unique // base64url WebAuthn credential id
  label        String
  wrap         String // JSON {iv,ct}: vault key wrapped by the device's PRF secret
  createdAt    DateTime @default(now())
}

/// Per-item audit trail — records WHEN an action happened (revealed/edited/copied/created), never the
/// value. Lets the owner see access history. (BEA-353)
model VaultAudit {
  id     String   @id @default(uuid())
  itemId String
  action String // created | edited | revealed | copied
  at     DateTime @default(now())

  @@index([itemId]) // matches the migration-created index (BEA-828)
}

/// One important email stored in memory (BEA-439). PK = Gmail message id so re-sync upserts (no dupes).
/// Full body is indexed into RAG + SuperMemory for whole-brain recall. supermemoryId/ragId are the
/// index doc pointers (replace-on-edit), never the secret.
model EmailMemory {
  id            String    @id // Gmail message id
  threadId      String
  fromAddr      String
  subject       String
  day           String // YYYY-MM-DD the email belongs to
  sentAt        DateTime?
  snippet       String?
  body          String? // full plain-text body
  supermemoryId String?
  ragId         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([day])
}

/// "The Lab" — the mini mental model (BEA-446). One MindFinding = one hypothesis/edge about the user,
/// learned from tasks (done/postponed/skipped) + stories + activity + ideas. It lives: reinforced by
/// recurrence, decays when evidence dries up (by its own cadence), confirmed/refuted by the user.
model MindFinding {
  id            String   @id @default(uuid())
  statement     String // human-readable hypothesis, e.g. "Money/deep-work tasks tend to drain you"
  action        String? // the ONE concrete thing to do differently — a finding without one isn't shown (BEA-1141)
  kind          String // emotional | behavioural | relational | temporal | causal
  subject       String // the "from" node, e.g. "money tasks"
  relation      String // e.g. drains | energizes | precedes | avoids | co-occurs
  object        String // the "to" node, e.g. "you" / "anxiety"
  valence       String   @default("neutral") // energizing | draining | neutral
  confidence    Float    @default(0.2) // 0–1
  evidenceCount Int      @default(1) // n
  daysSeen      Int      @default(1) // how many SEPARATE days backed it — nothing surfaces under 3 (BEA-1142)
  status        String   @default("proposed") // proposed | emerging | established | fading | retired
  cadence       String? // daily | weekly | situational | null
  trend         String   @default("rising") // rising | steady | fading
  validated     String? // null | confirmed | refuted  (user ✓/✗)
  pinned        Boolean  @default(false) // never decays
  firstSeenDay  String // YYYY-MM-DD
  lastSeenDay   String // YYYY-MM-DD
  supermemoryId String? // dual-store index pointers
  ragId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  evidence MindEvidence[]

  @@index([status])
}

/// Everything a staff member says, from either channel, as ONE record. (BEA-1159)
///
/// Before this, what they said lived in three places and only one of them was ever shown: a
/// WhatsApp reply became a ReminderMessage, a share-link note was welded to a TaskClaim quote, and
/// a report arriving became a TaskStatusDay. So half of every conversation was invisible, and a
/// blocker like "we didn't receive the sense PCB" was recorded as a green tick.
///
/// A review item IS an update — one that needs him. It opens when they say it, and closes ONLY when
/// he closes it. Nothing a person says afterwards can erase that they asked for help.
model TeamUpdate {
  id         String    @id @default(uuid())
  contactId  String
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  taskId     String?
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  /// whatsapp | link — how it reached him
  channel    String
  /// Their words, exactly. Never rewritten.
  text       String
  /// JSON array: done | needs_you | status | promise | chat. A message can be several at once.
  reads      String
  /// Does this need him? Derived from reads, stored so the inbox is one cheap query.
  needsYou   Boolean   @default(false)
  /// Plain English for why it reached him.
  why        String?
  /// When THEY said it (not when we wrote the row).
  at         DateTime
  /// Null while open. Set only by the owner closing it.
  closedAt   DateTime?
  /// When one message claims several jobs finished, he rules on each one. JSON array of the task
  /// ids he has already answered, so a decided row does not come back. (BEA-1159)
  answered   String?
  createdAt  DateTime  @default(now())

  @@index([contactId])
  @@index([needsYou, closedAt])
  @@index([at])
}

/// A concrete piece of evidence behind a MindFinding — the task/story/activity/idea that supports it.
model MindEvidence {
  id         String      @id @default(uuid())
  findingId  String
  finding    MindFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)
  sourceType String // task | story | activity | idea
  sourceId   String?
  day        String // YYYY-MM-DD
  signal     String // done | postponed | skipped | told | created
  snippet    String?
  createdAt  DateTime    @default(now())

  @@index([findingId])
}

// A plain run-log so the user can see WHEN automatic work ran (date + time). (BEA-468)
model MindRun {
  id     String   @id @default(uuid())
  at     DateTime @default(now())
  kind   String // learn | wrap
  day    String? // the day it concerns (YYYY-MM-DD)
  detail String

  @@index([at])
}

// The Situation model (BEA-515): your real chains — a GOAL, what's BLOCKING it, and the LEVER that unblocks it.
// e.g. goal "Get Beakn products out" / blocker "production not aligned" / lever "fix the production line first".
model MindChain {
  id           String   @id @default(uuid())
  goal         String
  blocker      String
  lever        String
  note         String?
  provenance   String? // where this came from: "From your 25 Jun story · deferred: X" (BEA-543)
  source       String // user | engine
  status       String   @default("active") // active | resolved | retired
  confidence   Float    @default(0.7)
  validated    String? // confirmed | refuted
  pinned       Boolean  @default(false)
  shifted      Boolean  @default(false) // engine re-derived this chain on day-close (ToC "repeat"); cleared when the user confirms/edits (BEA-526)
  firstSeenDay String?
  lastSeenDay  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

/// A visual flow (Phase 2 / n8n-style canvas, BEA-644). graph = React Flow {nodes, edges} JSON.
model Flow {
  id           String   @id @default(uuid())
  name         String   @default("Untitled flow")
  question     String? // the entry question the flow answers
  agentId      String? // the agent this flow was generated from (Agent↔Flow merge)
  graph        String   @default("{\"nodes\":[],\"edges\":[]}")
  schedule     String? // JSON Sched {every, at, dow} — when set, runs on a timer (Stage 3)
  lastFiredKey String? // dedup key so a schedule fires once per slot
  /// A hand-drawn flow that Auto-plan must not rewrite (BEA-1259). The planner is good at turning a
  /// question into branches, and terrible at leaving a working pipeline alone: one press would
  /// replace AI News Daily's fetch/split/categorise steps with generic web searches and silently
  /// throw the RSS work away. Same class of failure as BEA-1246.
  locked       Boolean  @default(false)
  /// Who drew this picture (BEA-1366): 'social' = built from the linked agent's settings, no AI, and
  /// rebuilt on every save of those settings; 'planner' = the AI planner drew it on the agent's save.
  /// null = drawn by hand / by an older path.
  drawnBy      String?
  /// 'drawing' while a re-draw runs in the background; 'failed' when the last one could not draw —
  /// the previous picture is KEPT and `drawNote` says so; null = the picture is current.
  drawStatus   String?
  drawNote     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// One execution of a Flow (BEA-646). results = JSON {nodeId: {status, output, kind, label}}.
model FlowRun {
  id           String    @id @default(uuid())
  flowId       String?
  status       String    @default("running") // running | done | failed
  results      String    @default("{}")
  finalOutput  String?
  grade        String? // JSON {verdict,score,criteria,notes} vs the job's Outcome (BEA-1191) — deep + voice runs are flows, and were coming back with no verdict at all
  spend        String? // JSON {searches,extracts,sources} — what deep research actually cost this run (BEA-1196)
  documentIds  String    @default("[]") // documents this run produced: JSON [{id, slug, title}]
  terminal     String    @default("[]") // live play-by-play: JSON [{text, at}]
  error        String?
  waitNodeId   String? // Move B: the "Ask me" node the run is paused on
  waitQuestion String? // the question shown to the user
  waitKind     String? // free_text | choice
  waitOptions  String    @default("[]") // JSON array of choices
  waitToken    String? // opaque resume token
  /// What this run was STARTED with, when something outside the flow handed it material — a service
  /// event's payload today (BEA-1350). Kept on the row so it survives a restart and a durable pause:
  /// the walk feeds it to every step that has nothing upstream, and to the Question box.
  input        String?
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
}

/// A person you can send WhatsApp reminders to (BEA-719).
model Contact {
  id             String     @id @default(uuid())
  name           String
  whatsappNumber String? // E.164 digits incl. country code; null until you add one
  notes          String?
  tags           String     @default("[]") // JSON string array
  aliases        String     @default("[]") // JSON array of other spellings/names for this same person (BEA-763)
  lastReadAt     DateTime? // when the owner last opened this contact's chat — powers unread badges (BEA-922)
  /// Their own page: name + a short random tail, e.g. "ramesh-k4f9". Short enough to read out,
  /// not guessable by trying another name. Null until the owner shares it. (BEA-1027)
  shareSlug      String?      @unique
  shareEnabled   Boolean      @default(true) // turn the page off without losing the link
  /// They have left. (BEA-1307)
  ///
  /// LEFT IS NOT DELETED. Deleting a contact cascades away every briefing the owner ever wrote about
  /// them, every word they ever said, and their weekly profile — and orphans their WhatsApp history
  /// into rows nothing can ever reach again. When Radha left there was no correct action available:
  /// delete lost the record, and stopping each chase by hand did nothing about her open work.
  ///
  /// Someone who has left keeps everything. They simply stop being part of the working system: no
  /// chasing, no new work, no share page, out of the pickers.
  leftAt         DateTime?
  leftNote       String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  reminders      Reminder[]
  messages       ReminderMessage[] // their conversation — deleted with them, never orphaned (BEA-1309)
  /// Brain doc ids for this person's rolling "where things stand" doc. (BEA-1031)
  supermemoryId  String?
  ragId          String?
  ownedTasks     Task[]       @relation("TaskOwner") // work this person owns (BEA-1019)
  taskLinks      TaskPerson[] // tasks they're @mentioned on (BEA-1019)
  briefings      Briefing[] // the situations you've told me about them (BEA-1020)
  claims         TaskClaim[] // work they say they've finished, waiting on you (BEA-1024)
  teamUpdates    TeamUpdate[] // everything they've said, both channels (BEA-1159)
  profile        ContactProfile? // the weekly character profile (BEA-1216)

  @@index([name])
}

/// The weekly character profile: who this person is and how they work, written by the app from
/// their reports and the owner's briefings. ONE living row per contact, rewritten in place every
/// week — and one living brain doc behind it (the ids below), so RAG never grows duplicates. (BEA-1216)
model ContactProfile {
  contactId     String   @id
  contact       Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  text          String
  weekStart     String // Monday key of the week this was last written for — the "already ran" guard
  supermemoryId String?
  ragId         String?
  updatedAt     DateTime @updatedAt
}

/// A WhatsApp reminder to chase a contact about a task (BEA-720).
model Reminder {
  id           String            @id @default(uuid())
  contactId    String
  contact      Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  taskId       String? // the Task this chases
  task         Task?             @relation(fields: [taskId], references: [id], onDelete: Cascade) // delete the work, the chase goes too (BEA-1021)
  /// none = the old one-day lifecycle (a fixed number of nudges, then it auto-pauses).
  /// daily = a real chase: repeats every day at `times` until the task is confirmed done, or you
  /// stop it. Existing reminders stay on "none" so nothing changes underneath you. (BEA-1021)
  repeat       String            @default("none")
  subject      String? // short "what you're chasing" for the template {{2}} (task title if linked)
  message      String // the free-text we send in the 24h window (in the user's voice)
  notes        String? // standing context Sandeep adds; fed into the agent's replies (BEA-765)
  count        Int               @default(1) // how many times today (1-5)
  times        String            @default("[]") // JSON array of ISO datetimes to send at
  status       String            @default("active") // active | done | stopped
  /// Captured outcome from an earlier build. NOTHING writes this any more (the agent stopped
  /// auto-closing reminders in BEA-948) but it IS still read and shown, and 4 live rows hold real
  /// text — so it is kept, not dropped. Verified 2026-07-21. (BEA-1038)
  feedback     String?
  /// Dead: the daily scheduler no longer uses it and every live row is null. Left in place because
  /// removing one empty column would mean rebuilding a live table for no benefit — the risk is
  /// larger than the tidiness. Do not start writing it. Verified 2026-07-21. (BEA-1038)
  lastFiredKey String?
  armedDay     String? // local day (YYYY-MM-DD) this reminder was armed/seeded for — one-day lifecycle (BEA-764)
  pausedAuto   Boolean           @default(false) // true when auto-paused at day rollover (vs paused by the user)
  needsOwner   Boolean           @default(false) // agent couldn't answer → flagged for Sandeep to reply (BEA-766)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  sends        ReminderSend[]
  messages     ReminderMessage[]

  @@index([contactId])
  @@index([status])
}

/// One scheduled send of a reminder (BEA-720). Fired by the outbound scheduler in P4.
model EmoDeviceReminder {
  id        String   @id @default(uuid())
  text      String // what to say/show when it rings
  dueAt     DateTime
  status    String   @default("active") // active | done | missed
  createdAt DateTime @default(now())

  @@index([status, dueAt])
}

model ReminderSend {
  id         String   @id @default(uuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  at         DateTime
  status     String   @default("queued") // queued | sending (claimed, BEA-775) | sent | delivered | read | failed | skipped
  providerId String? // the BSP (Postbox/WhatsApp) message id once sent
  error      String? // friendly error if the send failed
  createdAt  DateTime @default(now())

  @@index([reminderId])
  @@index([status])
}

/// The WhatsApp conversation for a reminder: our outbound nudges + the contact's replies.
/// C1 records these; the two-way agent (C2) reads/acts on them.
model ReminderMessage {
  id         String    @id @default(uuid())
  /// The conversation this belongs to — one per contact. (BEA-742)
  ///
  /// A REAL relation since BEA-1309. It was a bare column, and a conversation only surfaces in the
  /// Chats inbox through a live Reminder — so deleting a contact cascaded their reminders away and
  /// left the messages behind, pointing at an id that no longer existed: unreachable by any screen
  /// and undeletable by any code. Seven such rows were sitting in the live database.
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  reminderId String? // the reminder that triggered it (a combined nudge covers several)
  reminder   Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  direction  String // out | in
  body       String
  wamid      String?
  status     String? // out: sent | delivered | read | failed (WhatsApp receipts, BEA-916); in: null
  error      String? // provider error when status=failed
  /// Which of OUR messages this one answers, when they tapped a button or quote-replied. (BEA-1300)
  /// The link that makes a tap exact: it resolves through ReminderSend.providerId to the precise
  /// set of work that nudge was about, instead of a model guessing from the words.
  /// NOT guaranteed to be one of ours — someone can quote-reply to their own message — so a lookup
  /// that finds nothing is an ordinary outcome, not an error.
  replyToWamid String?
  /// The id of the button or list row they pressed. Its PRESENCE is the useful part: it proves this
  /// was a tap rather than the same word typed inside a sentence. (BEA-1300)
  buttonId   String?
  createdAt  DateTime  @default(now())

  @@index([contactId])
  @@index([reminderId])
  @@index([wamid])
}

/// A WhatsApp message the owner deleted, remembered by its id alone. (BEA-1309)
///
/// Deleting a chat message used to be impossible, so the inbound de-duplication could safely ask
/// "have I stored this wamid before?" — the row was immortal. Now that messages can be deleted, a
/// redelivered webhook (Postbox retries, and WhatsApp is at-least-once) would find nothing, store
/// the message again, and set the two-way agent replying to something the owner had just removed.
///
/// So the id outlives the message. Nothing else is kept — no body, no sender, no conversation.
model DeletedMessage {
  wamid String   @id
  at    DateTime @default(now())
}

/// A third-party OAuth client that registered (Dynamic Client Registration) to reach the public MCP. (BEA-758)
model OAuthClient {
  id           String   @id // the client_id
  secret       String? // optional; public clients (Claude) use PKCE with no secret
  name         String?
  redirectUris String // JSON array of allowed redirect URIs
  createdAt    DateTime @default(now())
}

/// A short-lived authorization code (PKCE) issued after the owner approves an OAuth client. (BEA-758)
model OAuthCode {
  code          String   @id
  clientId      String
  redirectUri   String
  codeChallenge String // S256 challenge; verified against the verifier at the token endpoint
  scope         String?
  userId        String
  used          Boolean  @default(false)
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([clientId])
}

/// EMO (BEA-861) — a "receipt" card for every voice capture. Deliberately THIN: it carries the raw
/// recording + transcript + a one-line summary of what Emo did, and LINKS to the real object
/// (task/reminder/flow/meeting/document) which stays the single source of truth. The "answer-later"
/// clarify (Needs-you HITL) lives ON the card. Named EmoCard so it never collides with UI "cards"
/// (which are Items). Design: /home/sandy/emo-behavior-design.md
model EmoCard {
  id            String   @id @default(uuid())
  lane          String // search | story | reminder | task | meeting | research | note | talk
  status        String   @default("cooking") // done | cooking | needs_you
  title         String?
  summary       String? // one-line "what Emo did" — readable without opening the link
  detail        String? // markdown body (curated findings, meeting summary, …)
  links         String   @default("[]") // JSON [{kind,id,label}] pointers to the real objects
  sources       String   @default("[]") // JSON [{n,title,link,when,snippet,sourceType,source}] cited sources
  needsQuestion String? // the clarify question shown on the card (durable Needs-you HITL)
  needsOptions  String   @default("[]") // JSON array of suggested answers (optional)
  needsAnswer   String? // the owner's answer once given
  source        String   @default("emo")
  /// The person this card is about, when there is one — so you can see everything EMO did for
  /// someone without hoping their name is in the text. (BEA-1034)
  contactId     String? // where the capture came from
  day           String // IST day key YYYY-MM-DD — powers the "Today's Captures" grouping
  rawTranscript String?
  audioPath     String? // the raw recording file (part of the receipt)
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([day])
  @@index([status])
  @@index([lane])
}

/// Recordings (BEA-973) — long ambient sessions (3-4h meetings) stored WITHOUT transcription.
/// Chunks are the device's raw opus-packet files on disk; marks are tap-to-transcribe windows
/// carrying wall-clock times. Only marks/ranges ever hit the STT bill.
model Recording {
  id        String    @id @default(uuid())
  title     String?
  startedAt DateTime // device wall clock, sanity-checked against server time
  endedAt   DateTime?
  seconds   Int       @default(0) // total audio seconds received
  status    String    @default("recording") // recording | done | archived
  source    String    @default("emo-cam")
  bytes     Int       @default(0)
  day       String // IST day key YYYY-MM-DD
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  chunks    RecordingChunk[]
  marks     RecordingMark[]

  @@index([day])
  @@index([status])
}

model RecordingChunk {
  id          String    @id @default(uuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  seq         Int
  seconds     Int       @default(0)
  bytes       Int       @default(0)
  path        String // file under RECORDINGS_DIR
  startSec    Int       @default(0) // offset of this chunk's start within the session
  createdAt   DateTime  @default(now())

  @@unique([recordingId, seq])
}

model RecordingMark {
  id          String    @id @default(uuid())
  recordingId String
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  atSeconds   Int // session offset of the tap (window end)
  windowSec   Int       @default(120) // how far back the transcription window reaches
  kind        String    @default("tap") // tap | manual
  wallTime    DateTime // absolute moment of atSeconds
  status      String    @default("pending") // pending | done | failed
  transcript  String?
  cardId      String?
  createdAt   DateTime  @default(now())

  @@index([recordingId])
  @@index([status])
}

/// One browser/device subscribed to Web Push (BEA-1088). Endpoint is the identity; dead
/// endpoints (410/404 on send) are pruned automatically.
model PushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

/// One daily issue of Smol AI News (BEA-1254). The feed carries ~688 issues but only the newest
/// ~10 include <content:encoded>; the rest are title + description + link. `rawHtml` holds the
/// unescaped full HTML when we have it, and `summaryOnly` says plainly when we don't — an edition
/// can only be built from an issue with real content.
model NewsIssue {
  id          String    @id @default(uuid())
  link        String    @unique
  title       String
  pubDate     DateTime
  description String    @default("")
  rawHtml     String?
  entities    String    @default("[]") // JSON string[] — model names, companies, handles, straight from <category>
  summaryOnly Boolean   @default(true)
  firstSeenAt DateTime  @default(now())
  fetchedAt   DateTime  @default(now())
  filledAt    DateTime? // when a summary-only issue later gained its full content

  // BEA-1255 — the count guarantee. extractedCount is EVERY piece the splitter produced; later
  // stages assert against it, and a disagreement fails the run instead of publishing a short
  // edition that looks complete.
  extractedCount Int?
  storyCount     Int?
  splitAt        DateTime?
  stories        NewsStory[]

  @@index([pubDate])
  @@index([summaryOnly])
}

/// One piece of a daily issue (BEA-1255). `kind` says what it is: `story` is the unit of news (a
/// top-level list item, carrying its nested sub-bullets); `theme` is a section label; `intro` is the
/// masthead blockquote; `unplaced` is text that fitted no known shape and is kept VISIBLE rather
/// than dropped. Nothing in an issue is discarded — that is the whole point of the split.
model NewsStory {
  id          String   @id @default(uuid())
  issueId     String
  order       Int
  kind        String
  sourceKind  String // twitter | reddit | discord | unknown
  sectionPath String   @default("")
  theme       String?
  text        String
  html        String
  links       String   @default("[]") // JSON string[]
  category    String? // filled in by BEA-1256; null until then, never a silent default
  /// A short written headline (BEA-1267). Comes back from the SAME section call that writes the
  /// prose, so it costs no extra engine turn. Null until an edition is written, and null after an
  /// engine failure — the page falls back to the story's first sentence, which is what it used to
  /// show all the time.
  headline    String?
  createdAt   DateTime @default(now())
  // Cascade added while the table was still new: deleting an issue must not leave its stories
  // behind as orphans nobody can reach. Retro-fitting a foreign key later means a table rewrite.
  issue       NewsIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  flagged     Boolean   @default(false) // BEA-1258 — "worth digging into"

  @@index([issueId])
  @@index([issueId, kind])
}

/// One published edition of AI News Daily (BEA-1257). Codex writes the WORDS — a headline, the
/// 60-second read, and a line plus paragraphs per category — and they are stored here as plain
/// text. The page template is ours (BEA-1261), so the design cannot drift and nothing the engine
/// returns is ever treated as markup.
model NewsEdition {
  id          String   @id @default(uuid())
  issueId     String   @unique
  /// Sequential, for the masthead: "Issue No. 1".
  number      Int      @unique
  /// The day this edition covers, as YYYY-MM-DD in the owner's timezone — also the public URL.
  day         String   @unique
  headline    String
  sixty       String   @default("[]") // JSON string[] — the 60-second read
  sections    String   @default("[]") // JSON WrittenSection[] — category, line, prose, storyCount, written
  storyCount  Int      @default(0)
  /// False when the engine could not write part of it. The edition still publishes, and SAYS so.
  engineOk    Boolean  @default(true)
  notes       String   @default("[]") // JSON string[] — what went wrong, in plain words
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// ---- AI Radar (BEA-1311) -------------------------------------------------
// Items synced from the collector fork's published JSON (inai-sandy/ai-news-radar
// on GitHub Pages). The radar's own item/story id is the primary key, which is
// what makes a re-sync update `lastSeenAt` instead of duplicating the row.

model RadarItem {
  /// The radar's stable id — item sha for 24h items, story id for daily picks.
  id            String   @id
  /// The title shown in the UI — always English (translated when the source was not).
  title         String
  /// Exactly what the radar gave us, kept for the "translated" marker's tooltip.
  titleOriginal String
  translated    Boolean  @default(false)
  /// A non-English title we could not translate yet. Hidden from every list until a
  /// later sync manages it — an item is never shown untranslated (spec B4).
  pendingTranslation Boolean @default(false)
  url           String
  source        String   @default("")
  /// The radar's ai_label — used as the category filter.
  category      String   @default("")
  aiScore       Float    @default(0)
  storyId       String   @default("")
  /// JSON [{name,url}] — the outlets behind a merged story, for the "N sources" badge.
  sources       String   @default("[]")
  /// True when the item is in daily-brief.json (the Scout Picks).
  isPick        Boolean  @default(false)
  /// How many outlets carry this story (from stories-merged.json). 1 = single-source;
  /// 2+ = "hot" — the Hot now section and Hot sort read this. (BEA-1323)
  heat          Int      @default(1)
  /// One plain-English sentence written by the engine (BEA-1312). Null = pending.
  whyItMatters  String?
  publishedAt   DateTime
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())

  @@index([publishedAt])
  @@index([pendingTranslation, publishedAt])
}

// Singleton sync state — the UI's "last synced X ago" and the honest counts of the
// last run come from here, and an unreachable fork records its error here instead
// of touching the items.
model RadarSync {
  id         String    @id @default("singleton")
  lastSyncAt DateTime?
  lastOkAt   DateTime?
  lastError  String?
  /// JSON of the last sync's counts (fetched/stored/known/translated/pending/blocked/failed).
  counts     String    @default("{}")
  updatedAt  DateTime  @updatedAt
}

/// One account the owner has logged into on an outside service (BEA-1345).
///
/// The provider (Composio today) is the source of truth for whether a connection still works; this
/// row is OUR side of it — the label the owner recognises and when it was last used. Several rows
/// per service are allowed on purpose: two Gmail inboxes are two connections, not a conflict.
model ServiceConnection {
  id                 String    @id @default(uuid())
  /// Service slug, e.g. "github" — never a vendor-specific name.
  service            String
  /// The provider's id for this connection.
  connectedAccountId String    @unique
  label              String?
  status             String    @default("ACTIVE")
  connectedAt        DateTime  @default(now())
  lastUsedAt         DateTime?

  @@index([service])
}

/// Every attempt to run an outside-service action — the flight recorder (BEA-1347).
///
/// Written on EVERY attempt, before the answer is known to be good and whether it succeeded or not,
/// including the ones that never left the building (nothing connected, two accounts and no choice).
/// Two jobs: the owner can see what a run really did, and the trigger echo guard has a source of
/// truth for "did we cause this event?" — without which an agent posting to Slack would trip its own
/// trigger and post again, forever.
model ToolCall {
  id        String   @id @default(uuid())
  /// The flow run or agent run that asked for it. Null for a call made outside a run.
  runId     String?
  /// 'flow' | 'agent' | 'chat' — which kind of run `runId` points at.
  runKind   String?
  agentId   String?
  /// The step inside the flow graph, so a call can be traced back to the node that made it.
  nodeId    String?
  /// Service slug, e.g. "github" — never a vendor-specific name.
  service   String
  /// OUR id for the action: `svc:github.create_issue`. Never the vendor's slug.
  action    String
  /// Which connected account it ran on, when the service has more than one.
  accountId String?
  /// The arguments we sent, as JSON, with anything that looks like a secret masked.
  arguments String?
  /// A short, readable account of what came back — never the whole payload.
  result    String?
  ok        Boolean  @default(false)
  /// The provider's real reason, in plain English, when it failed.
  error     String?
  ms        Int?
  /// Whether this call had to stop and ask first (the gate is BEA-1348; this column is its record).
  gated     Boolean  @default(false)
  /// What the provider charged for THIS call, in its own credits, read off its answer (BEA-1355).
  /// Null when the provider does not meter calls; 0 when it charged nothing (a cache hit).
  credits   Int?
  createdAt DateTime @default(now())

  @@index([service, createdAt])
  @@index([runId])
  @@index([createdAt])
}

/// ONE whole vendor answer, kept so a worker can be tested and repaired without spending a credit
/// (BEA-1386, agent workers 1/10 — `specs/AGENT-WORKERS.md` §A).
///
/// `ToolCall.result` is pretty-printed and then cut to 2,000 characters, which is why nothing can be
/// replayed today. This table keeps the answer WHOLE: masked, then gzipped into a BLOB — never
/// base64, which would add ~33% to a store the nightly backup copies in full.
///
/// Written from `ServiceActionsService.runDetailed()` on success only, opt-in per service, and never
/// for anything that could carry somebody's messages (see `NO_SAMPLE_SERVICES` in `tool-sample.ts`).
model ToolSample {
  id        String   @id @default(uuid())
  /// Service slug, e.g. "instagram" — never a vendor-specific name.
  service   String
  /// The action's own name, without the `svc:<service>.` in front of it.
  action    String
  /// OUR id for the action: `svc:instagram.search_hashtag`, for an exact lookup.
  actionId  String
  /// The job this answer came from. Null for a builder, chat or Social-page call.
  agentId   String?
  /// sha256 of the normalised (masked, key-sorted) arguments — one set of samples per call shape.
  argsHash  String
  /// The arguments as JSON, masked and UNCAPPED — `redact()` cuts at 4,000 characters and masks by
  /// key name only, which would miss a phone number in `wa_id` or an e-mail in `from`.
  arguments String
  /// The whole answer: masked, then gzipped. A BLOB, never base64.
  payload   Bytes
  /// Stored size in bytes, after gzip — what the eviction sweep counts against `TOTAL_BUDGET_MB`.
  bytes     Int
  /// 'good' (a real answer to test against) | 'failing' (kept as evidence of a break).
  kind      String   @default("good")
  /// Why a failing sample was kept, or why this one is not usable for tests (over the size cap).
  note      String?
  createdAt DateTime @default(now())

  @@index([actionId, kind, createdAt])
  @@index([agentId])
  @@index([argsHash])
}

/// A gate decision on an outside-service action that cannot be undone (BEA-1348).
///
/// Two shapes in one table, told apart by `scope`:
///  - `once`   — the owner said yes to ONE paused step. It carries the exact arguments he was
///               shown, so the resumed step runs THOSE and not a freshly-guessed set.
///  - `always` — "release permanently" from /tools: this action on this service never asks again.
model ServiceGate {
  id        String    @id @default(uuid())
  /// Service slug, e.g. "github" — never a vendor-specific name.
  service   String
  /// OUR id for the action: `svc:github.delete_a_repository`. Never the vendor's slug.
  action    String
  /// 'once' | 'always'
  scope     String    @default("once")
  /// The run and step a one-time answer belongs to. Null on a permanent release.
  runId     String?
  nodeId    String?
  /// 'approved' | 'rejected' — a permanent release is always 'approved'.
  decision  String    @default("approved")
  /// The exact arguments the owner approved, as JSON. Null on a permanent release.
  arguments String?
  /// What he was actually shown, kept so the log can be read back honestly.
  question  String?
  /// When the approved step really ran, so a one-time yes can never be spent twice.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([service, action])
  @@index([runId, nodeId])
}

/// One "when this happens in a service, run that flow" rule (BEA-1350).
///
/// The vendor's own event subscription lives behind `triggerInstanceId`. It is created when the
/// binding is switched on and DELETED when it is switched off or thrown away — an instance left
/// behind keeps billing events against the owner's account for a rule he thinks he turned off.
model TriggerBinding {
  id                String    @id @default(uuid())
  /// Service slug, e.g. "github" — never a vendor-specific name.
  service           String
  /// OUR id for the event: `evt:github.pull_request_event`. Never the vendor's slug.
  triggerType       String
  /// The vendor's id for the live subscription. Null whenever the binding is not listening.
  triggerInstanceId String?
  /// What the event starts. One of the two is set; a flow today, an agent later.
  flowId            String?
  agentId           String?
  /// The event's own settings (which repo, which channel), as JSON.
  config            String?
  /// Which connected account it listens on, when the service has more than one.
  accountId         String?
  /// The owner's own words for this rule, shown in the list.
  label             String?
  enabled           Boolean   @default(true)
  /// Runs an hour before the binding pauses itself. The loop guard of last resort.
  rateCap           Int       @default(20)
  lastFiredAt       DateTime?
  /// Why it stopped listening, in plain English. Null while it is healthy.
  pausedReason      String?
  createdAt         DateTime  @default(now())

  @@index([service])
  @@index([triggerType])
}

/// Every event that arrived for a binding, and what we did with it (BEA-1350).
///
/// A dropped event is written down exactly like a run: "we caused this ourselves" and "this one was
/// over the cap" are the two things the owner will want to see when a rule looks quiet.
model TriggerEvent {
  id          String   @id @default(uuid())
  bindingId   String?
  service     String
  /// OUR id for the event, as on the binding.
  triggerType String?
  /// ran | echo | capped | failed | ignored | busy
  status      String
  /// One line of plain English: what happened to this event.
  detail      String?
  /// The flow run it started, when it started one.
  runId       String?
  /// A short readable line about the event itself — who did what, where.
  summary     String?
  /// The `ToolCall` row we blamed, when this was dropped as our own echo.
  echoOfId    String?
  /// A trimmed copy of what arrived, so the history can be read back honestly.
  payload     String?
  createdAt   DateTime @default(now())

  @@index([bindingId, createdAt])
  @@index([createdAt])
}

/// The run journal (BEA-1387, agent workers 2/10 — `specs/AGENT-WORKERS.md` §H).
///
/// A worker is an imperative script: when it pauses on a question or a gate it EXITS, and the resume
/// re-runs it from the top. Every call that costs money or has an effect is recorded here against
/// the run, keyed by its position in the call order — so a replay returns the recorded value without
/// touching a vendor, a sheet or the owner's phone. Waiting is only free because of this table.
model RunJournal {
  id       String @id @default(uuid())
  runId    String
  /// The call's position in the run's call order, from 0. One row per position, ever.
  seq      Int
  /// sha256(seq + fn + argsHash) — stable across replays. A replay whose key does not match the
  /// recorded one means the worker is not repeatable, and it is failed loudly rather than repeated.
  stepKey  String
  /// "fetchSource" | "shape" | "writeSheet" | "notify" | "ask" | "seed" | …
  fn       String
  /// What the call returned, as JSON, gzipped.
  result   Bytes
  /// Stored size in bytes after gzip.
  bytes    Int      @default(0)

  createdAt DateTime @default(now())

  @@unique([runId, seq])
  @@index([runId])
}
